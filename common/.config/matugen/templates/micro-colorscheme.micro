# Material You dynamic colorscheme for Micro editor generated by Matugen

color-link default "#{{colors.on_surface.default.hex_stripped}},#{{colors.background.default.hex_stripped}}"
color-link comment "italic #{{colors.on_surface_variant.default.hex_stripped}}"
color-link constant "#{{colors.tertiary.default.hex_stripped}}"
color-link constant.number "#{{colors.secondary.default.hex_stripped}}"
color-link constant.string "#{{colors.primary.default.hex_stripped}}"
color-link identifier "#{{colors.secondary.default.hex_stripped}}"
color-link statement "bold #{{colors.primary.default.hex_stripped}}"
color-link symbol "#{{colors.tertiary.default.hex_stripped}}"
color-link symbol.operator "#{{colors.secondary.default.hex_stripped}}"
color-link preproc "#{{colors.secondary.default.hex_stripped}}"
color-link type "bold #{{colors.primary.default.hex_stripped}}"
color-link special "#{{colors.tertiary.default.hex_stripped}}"
color-link underlined "underlined #{{colors.primary.default.hex_stripped}}"
color-link error "bold #{{colors.error.default.hex_stripped}}"
color-link todo "bold #{{colors.tertiary.default.hex_stripped}}"

# UI Elements
color-link statusline "#{{colors.on_surface.default.hex_stripped}},#{{colors.surface_container_high.default.hex_stripped}}"
color-link tabbar "#{{colors.on_surface_variant.default.hex_stripped}},#{{colors.surface_container.default.hex_stripped}}"
color-link indent-char "#{{colors.outline_variant.default.hex_stripped}}"
color-link line-number "#{{colors.outline.default.hex_stripped}},#{{colors.background.default.hex_stripped}}"
color-link current-line-number "bold #{{colors.primary.default.hex_stripped}},#{{colors.surface_container.default.hex_stripped}}"
color-link cursor-line "#{{colors.surface_container.default.hex_stripped}}"
color-link color-column "#{{colors.surface_container.default.hex_stripped}}"
color-link divider "#{{colors.outline_variant.default.hex_stripped}},#{{colors.surface_container.default.hex_stripped}}"
color-link selection "#{{colors.on_primary_container.default.hex_stripped}},#{{colors.primary_container.default.hex_stripped}}"

# Diff & Gutter
color-link gutter-error "#{{colors.error.default.hex_stripped}}"
color-link gutter-warning "#{{colors.tertiary.default.hex_stripped}}"
color-link gutter-info "#{{colors.primary.default.hex_stripped}}"
color-link diff-added "#{{colors.primary.default.hex_stripped}}"
color-link diff-modified "#{{colors.tertiary.default.hex_stripped}}"
color-link diff-deleted "#{{colors.error.default.hex_stripped}}"
