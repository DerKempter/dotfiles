# Material You dynamic theme for btop generated by Matugen

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#{{colors.background.default.hex_stripped}}"

# Main text color
theme[main_fg]="#{{colors.on_surface.default.hex_stripped}}"

# Title color for boxes
theme[title]="#{{colors.primary.default.hex_stripped}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#{{colors.primary.default.hex_stripped}}"

# Background color of selected item in processes box
theme[selected_bg]="#{{colors.primary_container.default.hex_stripped}}"

# Foreground color of selected item in processes box
theme[selected_fg]="#{{colors.on_primary_container.default.hex_stripped}}"

# Color of inactive/disabled text
theme[inactive_fg]="#{{colors.outline.default.hex_stripped}}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#{{colors.on_surface_variant.default.hex_stripped}}"

# Background color of the percentage meters
theme[meter_bg]="#{{colors.surface_container_highest.default.hex_stripped}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#{{colors.secondary.default.hex_stripped}}"

# Box outline colors
theme[cpu_box]="#{{colors.outline_variant.default.hex_stripped}}"
theme[mem_box]="#{{colors.outline_variant.default.hex_stripped}}"
theme[net_box]="#{{colors.outline_variant.default.hex_stripped}}"
theme[proc_box]="#{{colors.outline_variant.default.hex_stripped}}"

# Box divider line and small boxes line color
theme[div_line]="#{{colors.outline_variant.default.hex_stripped}}"

# Temperature graph colors (cool -> warm -> hot/danger)
theme[temp_start]="#{{colors.primary.default.hex_stripped}}"
theme[temp_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[temp_end]="#{{colors.error.default.hex_stripped}}"

# CPU graph colors (low load -> medium load -> high load)
theme[cpu_start]="#{{colors.primary.default.hex_stripped}}"
theme[cpu_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[cpu_end]="#{{colors.error.default.hex_stripped}}"

# Mem/Disk free meter
theme[free_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[free_mid]="#{{colors.secondary.default.hex_stripped}}"
theme[free_end]="#{{colors.primary.default.hex_stripped}}"

# Mem/Disk cached meter
theme[cached_start]="#{{colors.secondary.default.hex_stripped}}"
theme[cached_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[cached_end]="#{{colors.primary.default.hex_stripped}}"

# Mem/Disk available meter
theme[available_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[available_mid]="#{{colors.secondary.default.hex_stripped}}"
theme[available_end]="#{{colors.primary.default.hex_stripped}}"

# Mem/Disk used meter (low usage -> medium usage -> critical usage)
theme[used_start]="#{{colors.primary.default.hex_stripped}}"
theme[used_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[used_end]="#{{colors.error.default.hex_stripped}}"

# Download graph colors
theme[download_start]="#{{colors.secondary.default.hex_stripped}}"
theme[download_mid]="#{{colors.primary.default.hex_stripped}}"
theme[download_end]="#{{colors.tertiary.default.hex_stripped}}"

# Upload graph colors
theme[upload_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[upload_mid]="#{{colors.secondary.default.hex_stripped}}"
theme[upload_end]="#{{colors.primary.default.hex_stripped}}"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#{{colors.primary.default.hex_stripped}}"
theme[process_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[process_end]="#{{colors.error.default.hex_stripped}}"

# Process box banner colors
theme[proc_pause_bg]="#{{colors.error.default.hex_stripped}}"
theme[proc_follow_bg]="#{{colors.primary.default.hex_stripped}}"
theme[proc_banner_bg]="#{{colors.surface_container_high.default.hex_stripped}}"
theme[proc_banner_fg]="#{{colors.on_surface.default.hex_stripped}}"

# Process following attributes
theme[followed_bg]="#{{colors.primary.default.hex_stripped}}"
theme[followed_fg]="#{{colors.on_primary.default.hex_stripped}}"
