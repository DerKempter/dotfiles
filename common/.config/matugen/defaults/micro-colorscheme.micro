# Material You dynamic colorscheme for Micro editor generated by Matugen

color-link default "#ebdfe9,#171118"
color-link comment "italic #d2c1d2"
color-link constant "#e7b7e8"
color-link constant.number "#ecb8ce"
color-link constant.string "#74d7cb"
color-link identifier "#ecb8ce"
color-link statement "bold #74d7cb"
color-link symbol "#e7b7e8"
color-link symbol.operator "#ecb8ce"
color-link preproc "#ecb8ce"
color-link type "bold #74d7cb"
color-link special "#e7b7e8"
color-link underlined "underlined #74d7cb"
color-link error "bold #ffb4ab"
color-link todo "bold #e7b7e8"

# UI Elements
color-link statusline "#ebdfe9,#2f282f"
color-link tabbar "#d2c1d2,#241d25"
color-link indent-char "#4f4350"
color-link line-number "#9b8c9b,#171118"
color-link current-line-number "bold #74d7cb,#241d25"
color-link cursor-line "#241d25"
color-link color-column "#241d25"
color-link divider "#4f4350,#241d25"
color-link selection "#91f4e7,#005049"

# Diff & Gutter
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e7b7e8"
color-link gutter-info "#74d7cb"
color-link diff-added "#74d7cb"
color-link diff-modified "#e7b7e8"
color-link diff-deleted "#ffb4ab"
